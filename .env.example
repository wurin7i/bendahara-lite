# Salin file ini menjadi .env lalu isi nilainya. Lihat README.md untuk langkah membuat Client ID.

# (WAJIB) OAuth 2.0 Client ID bertipe "Web application" dari Google Cloud Console
VITE_GOOGLE_CLIENT_ID=

# (Opsional) ID spreadsheet bawaan. Bila diisi, pengguna tidak perlu menempel
# URL spreadsheet saat pertama kali masuk.
VITE_SPREADSHEET_ID=
